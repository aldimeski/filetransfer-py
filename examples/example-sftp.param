InputDir:/srv/export/
OutputDir:/data/target/input/
KeepInput:Y
SftpCheck:Y
SftpType:Key
SftpPassFile:None
SftpHost:192.0.2.10
SftpUser:sftpuser
SftpKey:/home/user/.ssh/id_rsa
FileMask:^OK_Export_File_<YYYYMMDD>.*zip$
FileDateCheck:Y
FileCreationDate:<YYYY-MM-DD-1d>&date<YYYY-MM-DD>
SubDirCheck:N
SizeCheck:N
CtlFileCheck:N
CtlFileExtension:NONE
GzipOutput:N
GzipInput:N
ArchiveCheck:N
ArchiveDir:/data/archive/
LogMode:Full
LogDir:/var/log/filetransfer/
LogFile:example.log
Notification:Y
NotificationSender:transfer@example.com
NotificationRe:ops@example.com
NotificationCc:transfer@example.com
NotificationMethod:smtp
NotificationServer:smtp.example.com
